[Unit]
Description=Discord Print Bot (Epson TM-T88VI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_LINUX_USER
Group=lp
WorkingDirectory=/home/YOUR_LINUX_USER/Discord-PrintBot-linux-ver
EnvironmentFile=/home/YOUR_LINUX_USER/Discord-PrintBot-linux-ver/.env
ExecStart=/home/YOUR_LINUX_USER/Discord-PrintBot-linux-ver/venv/bin/python bot.py
Restart=always
RestartSec=5

# Hardening (safe defaults)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/YOUR_LINUX_USER/Discord-PrintBot-linux-ver

[Install]
WantedBy=multi-user.target
