# Discord Bot Configuration
# Copy this file to .env and fill in your actual values

# Your Discord Bot Token (get from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Linux USB printer settings (Epson TM-T88VI default)
# Your Epson TM-T88VI is usually 04b8:0202
PRINTER_USB_VID=0x04B8
PRINTER_USB_PID=0x0202

# Optional endpoint overrides (usually correct for TM-T88VI)
PRINTER_USB_IN_EP=0x82
PRINTER_USB_OUT_EP=0x01

# Optional USB timeout in milliseconds (0 = lib default)
PRINTER_USB_TIMEOUT=0

# Optional ESC/POS profile (leave as default unless needed)
PRINTER_PROFILE=default

# Optional image max width in pixels (reduce if images are clipped)
PRINTER_IMAGE_MAX_WIDTH=512

# Optional max download size per attachment/embed in bytes
MAX_DOWNLOAD_BYTES=26214400

# Optional print command cooldown in seconds
PRINT_COOLDOWN_SECONDS=3

# Optional comma-separated Discord role IDs allowed to print
# Leave empty to allow all roles/users
PRINT_ALLOWED_ROLE_IDS=

# Optional log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
